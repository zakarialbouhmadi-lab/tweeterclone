<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark Theme -->
    <style name="Base.Theme.TweeterClone" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/primary_light</item>
        <item name="colorSecondaryVariant">@color/primary</item>
        <item name="colorOnSecondary">@color/black</item>
        
        <!-- Background and surface -->
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorSurface">@color/background_card_dark</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
        
        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/background_dark</item>
        
        <!-- Button styles -->
        <item name="materialButtonStyle">@style/Widget.App.Button.Dark</item>
        
        <!-- Popup/Overflow menu -->
        <item name="popupMenuStyle">@style/Widget.App.PopupMenu.Dark</item>
        <item name="android:popupMenuStyle">@style/Widget.App.PopupMenu.Dark</item>
        <item name="actionOverflowMenuStyle">@style/Widget.App.PopupMenu.Dark</item>
    </style>
    
    <!-- Custom Button Style for Dark Theme -->
    <style name="Widget.App.Button.Dark" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/primary</item>
    </style>
    
    <!-- Popup Menu Style for Dark Theme -->
    <style name="Widget.App.PopupMenu.Dark" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@color/background_card_dark</item>
    </style>
    
    <!-- Popup overlay for dark theme -->
    <style name="ThemeOverlay.App.PopupMenu.Dark" parent="ThemeOverlay.Material3.Dark">
        <item name="android:textColor">@color/text_primary_dark</item>
        <item name="android:textColorPrimary">@color/text_primary_dark</item>
        <item name="android:textColorSecondary">@color/text_secondary_dark</item>
    </style>
</resources>
